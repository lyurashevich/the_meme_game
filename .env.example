# Database settings

DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_password
DB_HOST=db
DB_PORT=5432
TEST_DB_NAME=your_test_db_name

# Redis settings (not used yet, reserved for future use)
REDIS_PASSWORD=your_redis_password

# Logging
LOG_LEVEL=INFO

# Card editing API (POST/PATCH/DELETE /api/memes, /api/situations) needs header X-Admin-Token
# with this value. Leave empty to disable it. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
