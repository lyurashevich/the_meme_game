# Copy to .env and fill in. Read by the backend (from the project root, wherever it is
# started) and by docker compose, which takes ${...} values in its files from here.

# --- Database (PostgreSQL only) -------------------------------------------------------
# All of these are required: without them the backend stops at startup and names what's missing.
DB_NAME=meme_game
DB_USER=meme
DB_PASSWORD=change-me
# Where the backend finds PostgreSQL when it runs without Docker (uvicorn, scripts, tests).
# In docker compose the backend always uses db:5432, whatever is written here.
DB_HOST=localhost
DB_PORT=5432
# A separate database for pytest, on the same server and for the same user. The tests empty its
# tables, so never point it at the database with real data. Create it once, e.g.:
#   sudo -u postgres createdb -O meme meme_game_test
TEST_DB_NAME=meme_game_test

# --- Backend ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Card editing API (POST/PATCH/DELETE /api/memes, /api/situations) needs header X-Admin-Token
# with this value. Leave empty to disable it. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# --- Ports on the host (docker compose) ------------------------------------------------
# Development (docker compose up): change if something else already uses them
DB_DOCKER_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Production (with docker-compose.prod.yml): the only port open to the outside
WEB_PORT=80
